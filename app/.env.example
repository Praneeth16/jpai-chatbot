# Local development only. In Databricks Apps these come from resources/app.yml (config.env).
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=jpai-chatbot
# Lakebase (Postgres)
LAKEBASE_ENDPOINT=projects/<project-id>/branches/production/endpoints/<endpoint-id>
PGHOST=<postgres-host>
PGPORT=5432
PGDATABASE=databricks_postgres
PGSSLMODE=require
# Router
MODEL_SERVICE_NAME=system.ai.openjev-qwen35-4b
AI_SEARCH_INDEX=<catalog>.<schema>.if_chunks_idx
REF_SCHEMA=<schema>
DOCS_VOLUME=/Volumes/<catalog>/<schema>/docs
PAGE_IMAGES_VOLUME=/Volumes/<catalog>/<schema>/page_images
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
INGEST_JOB_ID=<ingest-job-id>
MLFLOW_EXPERIMENT_ID=<experiment-id>
# Comma-separated admins: document upload, raw ops messages and the "Why this route?" panel (empty = nobody)
ADMIN_EMAILS=you@example.com
# Optional JSON overriding router settings. Keys: tau_ae, tau_inj, tau_req, tau_intent, tau_cond, tau_ret,
# off_topic_streak, depth_margin, num_results, max_verbatim_chars, require_qa_approved
# ROUTER_CONFIG={"tau_intent":0.5,"max_verbatim_chars":8000}
# Dev-only identity fallback (never active when NODE_ENV=production)
# DEV_USER_EMAIL=you@example.com
